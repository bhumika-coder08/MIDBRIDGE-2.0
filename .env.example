# MidBridge 2.0 Environment Configuration

# Server
SERVER_PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL URL; when empty or unconnected, MidBridge 2.0 automatically initializes an embedded zero-config relational database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/midbridge
 
# Authentication & Security
JWT_SECRET=midbridge_jwt_super_secret_production_key_2026_9831a
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=midbridge_jwt_refresh_secret_production_key_2026_1984b

# Optional External AI & OCR Services (If not provided, MidBridge 2.0 uses its built-in context intelligence engine)
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
TRANSLATION_API_KEY=
OCR_API_KEY=
